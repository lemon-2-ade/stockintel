# ---------------------------------------------------------------------------
# Copy to .env (`make env`) and change the passwords. NEVER commit .env.
# Values here serve two audiences:
#   * docker compose (secrets for the containers), and
#   * code/tests running on the host (hence localhost + published ports).
# Containers get container-network hostnames from docker-compose.yml instead.
# ---------------------------------------------------------------------------

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=stockintel
POSTGRES_USER=stockintel
POSTGRES_PASSWORD=change-me-postgres
# MLflow's own database/role (created on first Postgres start)
MLFLOW_DB_PASSWORD=change-me-mlflow

# --- Redis -----------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis

# --- Kafka -----------------------------------------------------------------
# Host processes use the EXTERNAL listener; containers use kafka:9092.
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# Single local broker. Production: replication 3, min.insync.replicas 2.
KAFKA_TOPIC_REPLICATION_FACTOR=1
KAFKA_TOPIC_MIN_INSYNC_REPLICAS=1
# For managed Kafka (MSK / Confluent Cloud) set, e.g.:
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=SCRAM-SHA-512
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

# --- MLflow ----------------------------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000

# --- Grafana ---------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
# json (default, machine-readable) | console (pretty, for local debugging)
LOG_FORMAT=json

# --- Optional market-data providers (Phase 5+) ------------------------------
# Leave empty: the platform runs fully in simulation mode without any key.
ALPHAVANTAGE_API_KEY=
POLYGON_API_KEY=
FINNHUB_API_KEY=

# --- Market producer (Phase 2) -----------------------------------------------
# simulator (GBM, calibrated from history) | replay (historical snapshot)
PRODUCER_MODE=simulator
# Comma-separated tickers; empty = the 12 calibrated symbols
PRODUCER_SYMBOLS=
# Bar length: 1s 5s 1m 5m 15m 1h 1d. One bar per symbol is emitted per interval.
PRODUCER_INTERVAL=1s
# Bars generated instantly on start so charts have history
PRODUCER_BACKFILL_BARS=300
PRODUCER_SEED=42
# >1 exaggerates volatility for livelier demos
PRODUCER_VOLATILITY_MULTIPLIER=1.0
# Per-bar, per-symbol probabilities of injected anomalies
PRODUCER_PRICE_JUMP_PROBABILITY=0.001
PRODUCER_VOLUME_SPIKE_PROBABILITY=0.002
